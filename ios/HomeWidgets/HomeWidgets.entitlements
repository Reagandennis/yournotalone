<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Where the app leaves the widgets' numbers and words (the same group
	     as ios/Runner/Runner.entitlements). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.techgetafrica.yournotalone</string>
	</array>
</dict>
</plist>
