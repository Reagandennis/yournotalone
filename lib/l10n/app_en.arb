  "faqMoveQ": "What if I need to cancel or move my session?",
  "@faqMoveQ": {
    "description": "FAQ question (a heading people tap to open the answer)."
  },
  "faqMoveA": "You can cancel in the app up to 24 hours before your session and you'll be refunded in full. To move it, reply to your booking email at least 24 hours before and we'll rebook you. A session cancelled later than that, or one you don't join, isn't refunded — your therapist has set that time aside for you. If we or your therapist have to cancel, you're refunded in full.",
  "@faqMoveA": {
    "description": "FAQ answer, shown when the question is opened. Help text: warm, plain, second person. Cancellation policy: keep the terms (24 hours, full refund) exact."
  },
  "faqHowSessionsQ": "How do sessions work?",
  "@faqHowSessionsQ": {
    "description": "FAQ question (a heading people tap to open the answer)."
  },
  "faqHowSessionsA": "They're private video calls, right in the app. The Join button appears 10 minutes before the start, and you'll need your camera and microphone. Calls aren't recorded.",
  "@faqHowSessionsA": {
    "description": "FAQ answer, shown when the question is opened. Help text: warm, plain, second person."
  },
  "faqRemindedQ": "Will I be reminded?",
  "@faqRemindedQ": {
    "description": "FAQ question (a heading people tap to open the answer)."
  },
  "faqRemindedA": "Yes. You'll get an email and a phone notification when you're matched, if anything changes, and 10 minutes before your session. Phone notifications can arrive a little later than the emails.",
  "@faqRemindedA": {
    "description": "FAQ answer, shown when the question is opened. Help text: warm, plain, second person."
  },
  "faqCancelSessionQ": "Can I cancel a session?",
  "@faqCancelSessionQ": {
    "description": "FAQ question (a heading people tap to open the answer)."
  },
  "faqCancelSessionA": "Yes. You can cancel a request, or a matched session you haven't paid for, from the same screen. To cancel a paid session, contact us before it starts and we'll refund you.",
  "@faqCancelSessionA": {
    "description": "FAQ answer, shown when the question is opened. Help text: warm, plain, second person."
  },
  "faqWhoQ": "Who are the therapists?",
  "@faqWhoQ": {
    "description": "FAQ question (a heading people tap to open the answer)."
  },
  "faqWhoA": "Licensed mental-health professionals. Our care team matches you based on what you share in your request, so you don't have to scroll through directories while you're struggling. Once you're matched, you can see their profile — credentials, experience and what they specialise in.",
  "@faqWhoA": {
    "description": "FAQ answer, shown when the question is opened. Help text: warm, plain, second person."
  },
  "faqRateQ": "Can I rate my session?",
  "@faqRateQ": {
    "description": "FAQ question (a heading people tap to open the answer)."
  },
  "faqRateA": "Yes — after a session, tap it under Past sessions. Your therapist never sees your rating on its own, only an average across several people.",
  "@faqRateA": {
    "description": "FAQ answer, shown when the question is opened. Help text: warm, plain, second person. \"Past sessions\" is a heading on the therapy screen."
  },
  "faqSectionPrivacy": "Privacy & your data",
  "@faqSectionPrivacy": {
    "description": "FAQ section heading (shown in capitals)."
  },
  "faqJournalQ": "Who can read my journal?",
  "@faqJournalQ": {
    "description": "FAQ question (a heading people tap to open the answer)."
  },
  "faqJournalA": "Only you. Your entries are protected by row-level security, which means only your signed-in account can retrieve them — our team doesn't read them.",
  "@faqJournalA": {
    "description": "FAQ answer, shown when the question is opened. Help text: warm, plain, second person."
  },
  "faqSellDataQ": "Do you sell my data or show ads?",
  "@faqSellDataQ": {
    "description": "FAQ question (a heading people tap to open the answer)."
  },
  "faqSellDataA": "Never. No ads, no analytics trackers, no data brokers. We collect only what the app needs to work — the Privacy Policy in Settings spells out every detail.",
  "@faqSellDataA": {
    "description": "FAQ answer, shown when the question is opened. Help text: warm, plain, second person."
  },
  "faqDeleteQ": "How do I delete my account and data?",
  "@faqDeleteQ": {
    "description": "FAQ question (a heading people tap to open the answer)."
  },
  "faqDeleteA": "Settings → Delete account removes your profile, journal, moods, recovery data, and therapy sessions permanently. You can also email us from your registered address and we'll do it for you. Deletion can't be undone.",
  "@faqDeleteA": {
    "description": "FAQ answer, shown when the question is opened. Help text: warm, plain, second person."
  },
  "faqSectionAccount": "Your account",
