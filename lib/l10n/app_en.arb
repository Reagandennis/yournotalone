  "awakeTitle": "Awake at 3am?",
  "@awakeTitle": {
    "description": "Screen title. Awake at 3am? (sleep toolkit: the 20-minute rule, used in the middle of the night). Short."
  },
  "awakeStep1Title": "Awake, and it's not passing?",
  "@awakeStep1Title": {
    "description": "Step 1 heading. Awake at 3am? (sleep toolkit: the 20-minute rule, used in the middle of the night)."
  },
  "awakeStep1Hint": "Don't check the time — it only gives you sums to do. If it feels like you've been lying here twenty minutes or more, that's long enough.",
  "@awakeStep1Hint": {
    "description": "Step 1 hint under the heading. Awake at 3am? (sleep toolkit: the 20-minute rule, used in the middle of the night). Gentle, sleepy tone."
  },
  "awakeStep1Note": "Lying in bed awake and frustrated teaches your brain that the bed is a place to be awake and frustrated. Getting up breaks that link. It feels backwards; it's the most reliable trick sleep clinics have.",
  "@awakeStep1Note": {
    "description": "Step 1 explanatory note. Awake at 3am? (sleep toolkit: the 20-minute rule, used in the middle of the night)."
  },
  "awakeStep2Title": "Get up. Low light, something dull.",
  "@awakeStep2Title": {
    "description": "Step 2 heading. Awake at 3am? (sleep toolkit: the 20-minute rule, used in the middle of the night)."
  },
  "awakeStep2Hint": "Another room if you can. No bright screens, no news, no work. Boring is the goal — you're waiting for sleepiness to come back, not entertaining yourself.",
  "@awakeStep2Hint": {
    "description": "Step 2 hint. Awake at 3am? (sleep toolkit: the 20-minute rule, used in the middle of the night)."
  },
  "awakeTimerHint": "Sleepy before this runs out? Go back to bed now — sleepiness wins over the timer.",
