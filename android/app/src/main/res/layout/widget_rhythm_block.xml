<?xml version="1.0" encoding="utf-8"?>
<!-- The week: shared by both widgets. Ids are filled in by HomeWidgets.kt;
     the words here are only the gallery preview's. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_rhythm"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- The four-pillar stripe, as under the app's headings. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="4dp"
        android:orientation="horizontal">
        <ImageView android:layout_width="14dp" android:layout_height="4dp" android:importantForAccessibility="no" android:src="@drawable/widget_pillar_red" />
        <ImageView android:layout_width="14dp" android:layout_height="4dp" android:layout_marginStart="3dp" android:importantForAccessibility="no" android:src="@drawable/widget_pillar_blue" />
        <ImageView android:layout_width="14dp" android:layout_height="4dp" android:layout_marginStart="3dp" android:importantForAccessibility="no" android:src="@drawable/widget_pillar_black" />
        <ImageView android:layout_width="14dp" android:layout_height="4dp" android:layout_marginStart="3dp" android:importantForAccessibility="no" android:src="@drawable/widget_pillar_yellow" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_week_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/widget_week"
        android:textColor="@color/widget_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_days"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="@string/widget_days"
        android:textColor="@color/widget_ink"
        android:textSize="17sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/widget_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/widget_dot_0"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_dot_on" />
        <ImageView
            android:id="@+id/widget_dot_1"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginStart="5dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_dot_off" />
        <ImageView
            android:id="@+id/widget_dot_2"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginStart="5dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_dot_on" />
        <ImageView
            android:id="@+id/widget_dot_3"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginStart="5dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_dot_off" />
        <ImageView
            android:id="@+id/widget_dot_4"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginStart="5dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_dot_off" />
        <ImageView
            android:id="@+id/widget_dot_5"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginStart="5dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_dot_off" />
        <ImageView
            android:id="@+id/widget_dot_6"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginStart="5dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_dot_off" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/widget_check_in"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_button"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/widget_check_in"
        android:textColor="@color/widget_on_accent"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_checked_in"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/widget_muted"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
