<?xml version="1.0" encoding="utf-8"?>
<!-- Streamed narration reaches the voice player through a proxy on the
     phone itself (lib/media/narration_stream.dart). Plain HTTP is allowed
     to that address only; everything else keeps the default HTTPS-only rule. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
