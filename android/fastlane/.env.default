# Defaults loaded by fastlane for every lane. Override in android/fastlane/.env
# (gitignored). Do NOT put secrets in this file.

# Path (relative to android/) of the Google Play service-account JSON key.
# Leave commented here; set it in .env once you have the key.
# SUPPLY_JSON_KEY=play-service-account.json

# Skip the interactive fastlane update nag.
FASTLANE_SKIP_UPDATE_CHECK=1
FASTLANE_HIDE_CHANGELOG=1

# Default staged-rollout fraction for the production lane (0.0-1.0).
PLAY_DEFAULT_ROLLOUT=0.1
